LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Free script writing (optional) ---
# Any OpenAI-compatible endpoint works with LLM_PROVIDER=openai.
#
# OpenRouter (free-tier models):
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-or-...           (your OpenRouter key)
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free   (or any :free model)
#
# NVIDIA NIM (free developer credits at build.nvidia.com):
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=nvapi-...           (your NVIDIA key)
#   OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
#   OPENAI_MODEL=meta/llama-3.3-70b-instruct
#
# Free models write weaker scripts than Claude/GPT-4o, but cost $0 to test with.

ELEVENLABS_API_KEY=

STABILITY_API_KEY=

# --- Free LOCAL image + voice generation (optional, no keys needed) ---
# Images via the Draw Things Mac app (turn on Settings -> API Server first):
#   IMAGE_PROVIDER=drawthings
#   DRAWTHINGS_URL=http://127.0.0.1:7860     (default)
#   DRAWTHINGS_STEPS=30                      (default)
#
# Voice via a local Coqui TTS v2 (XTTS-v2) server — supports Greek ("el"):
#   TTS_PROVIDER=xtts
#   XTTS_URL=http://127.0.0.1:5002           (default)
# Start the server with:
#   tts-server --model_name tts_models/multilingual/multi-dataset/xtts_v2
# Character "voice" is then an XTTS speaker name (e.g. "Damien Black") or a
# path to a short .wav sample to clone.
