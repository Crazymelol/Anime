LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Free script writing via OpenRouter (optional) ---
# OpenRouter is OpenAI-compatible, so it works with LLM_PROVIDER=openai:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-or-...           (your OpenRouter key)
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free   (or any :free model)
# Free models write weaker scripts than Claude/GPT-4o, but cost $0 to test with.

ELEVENLABS_API_KEY=

STABILITY_API_KEY=
